+
+  static Future<void> sendNotificationToUser(String targetUid, String title, String body, {String type = 'GENERAL'}) async {
+    // 1. Save to Firestore DB (Inbox)
+    final notification = NotificationModel(
+      id: '',
+      userId: targetUid,
+      title: title,
+      body: body,
+      type: type,
+      read: false,
+      timestamp: DateTime.now(),
+    );
+    await _notificationRepo.saveNotification(notification);
+
+    // 2. Fetch FCM Token and send Push
+    final doc = await _db.collection('users').doc(targetUid).get();
+    if (doc.exists && doc.data()!.containsKey('fcmToken')) {
+      final token = doc['fcmToken'];
+      if (token != null && token.toString().isNotEmpty) {
+        await sendPushNotification(token, title, body, type: type);
+      }
+    }
+  }
+
+  static Future<void> sendNotificationToRole(String role, String title, String body, {String type = 'GENERAL'}) async {
+    // Find all users with this role
+    final query = await _db.collection('users').where('role', isEqualTo: role).get();
+    
+    for (var doc in query.docs) {
+      final targetUid = doc.data().containsKey('uid') ? doc['uid'] : doc.id;
+      
+      // Save notification & send push individually (calls sendNotificationToUser)
+      await sendNotificationToUser(targetUid, title, body, type: type);
+    }
